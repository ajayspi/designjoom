---
import Icon from "./Icon.astro";
import djLogo from "../imports/Designjoom-logo-1.png";

const links = ["About", "Metrics", "Experience", "Projects", "Skills", "Contact"];
const logoFilter = "invert(1) sepia(1) saturate(6) hue-rotate(195deg) brightness(1.4)";
const EMAIL = "ajayspi@gmail.com";
---

<nav class="nav" data-nav>
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between gap-3">
    <a href="/" class="nav-logo" aria-label="A V Ajay Kiran — home">
      <img src={djLogo.src} alt="DesignJoom" width={171} height={28}
        style={`height:28px;width:auto;filter:${logoFilter};transition:opacity .2s`} />
    </a>

    <div class="hidden md:flex items-center gap-8">
      {links.map((l) => <a href={`/#${l.toLowerCase()}`} class="nav-link">{l}</a>)}
    </div>

    <div class="flex items-center gap-2">
      <button class="theme-toggle" data-theme-toggle data-mode="dark" type="button"
              aria-label="Switch colour theme" aria-pressed="false">
        <Icon name="sun" size={15} class="icon-sun" />
        <Icon name="moon" size={15} class="icon-moon" />
      </button>

      <a href={`mailto:${EMAIL}`} class="hire-btn hidden md:flex">
        <Icon name="zap" size={12} /> Hire Me
      </a>

      {/* Below md the link list above is hidden, so this is the only way to navigate. */}
      <button class="menu-btn" data-menu-toggle type="button"
              aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-menu-panel hidden>
    {links.map((l) => <a href={`/#${l.toLowerCase()}`} class="mobile-link">{l}</a>)}
    <a href={`mailto:${EMAIL}`} class="mobile-link mobile-hire">
      <Icon name="zap" size={13} /> Hire Me
    </a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    background: transparent;
    border-bottom: 1px solid transparent;
    padding: 20px 0;
    transition: background-color .5s, border-color .5s, padding .5s, backdrop-filter .5s;
  }
  .nav.scrolled {
    background: var(--overlay);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--line);
    padding: 12px 0;
  }
  .nav-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .nav-logo:hover { opacity: .9; }
  .hire-btn {
    align-items: center; gap: 8px;
    padding: 8px 16px; border-radius: 999px;
    background: var(--line);
    border: 1px solid var(--line-strong);
    color: var(--blue);
    font-family: 'JetBrains Mono', monospace;
    font-size: .78rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color .3s;
  }
  .hire-btn:hover { background: var(--line-strong); }

  .theme-toggle, .menu-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; padding: 0;
    border-radius: 999px;
    background: var(--chip);
    border: 1px solid var(--hairline);
    color: var(--secondary-foreground);
    cursor: pointer;
    transition: background-color .25s, border-color .25s, color .25s;
  }
  .theme-toggle:hover, .menu-btn:hover {
    background: var(--line); border-color: var(--line-strong); color: var(--blue);
  }

  /* Which glyph shows is driven by data-mode on the button itself, set in nav.ts.
     Reading the ancestor [data-theme] here would break Astro's style scoping. */
  .theme-toggle .icon-moon { display: none; }
  .theme-toggle[data-mode='light'] .icon-sun { display: none; }
  .theme-toggle[data-mode='light'] .icon-moon { display: inline; }

  .menu-btn { flex-direction: column; gap: 4px; }
  .menu-btn span {
    display: block; width: 15px; height: 1.5px;
    background: currentColor; border-radius: 2px;
    transition: transform .3s ease, opacity .2s ease;
  }
  .menu-btn[aria-expanded='true'] span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .menu-btn[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .menu-btn[aria-expanded='true'] span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  .mobile-menu {
    display: flex; flex-direction: column; gap: 2px;
    margin-top: 12px;
    padding: 12px 24px 18px;
    background: var(--overlay);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid var(--line);
    animation: menu-in .28s cubic-bezier(.22, .61, .36, 1);
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-link {
    padding: 11px 4px; border-radius: 8px;
    font-size: .95rem;
    color: var(--secondary-foreground);
    text-decoration: none;
    transition: color .2s, padding-left .2s;
  }
  .mobile-link:hover { color: var(--foreground); padding-left: 10px; }
  .mobile-hire {
    display: flex; align-items: center; gap: 8px;
    color: var(--blue);
    font-family: 'JetBrains Mono', monospace;
    font-size: .82rem;
  }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: none; }
  }

  /* Explicit, not Tailwind's md:hidden — a utility and a scoped rule of equal
     specificity would leave the winner up to bundle order. */
  @media (min-width: 768px) {
    .menu-btn, .mobile-menu { display: none !important; }
  }
</style>
