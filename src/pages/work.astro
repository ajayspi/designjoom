---
import { PROJECTS } from "../data";

const services = {
  "AI Content": "ai-product",
  "AI Video Generation": "ai-product",
  "UX Strategy": "ux-strategy",
  "SEO": "growth",
  "Growth Strategy": "growth",
  "Digital Transformation": "ux-strategy",
  "Website Development": "architecture",
  "Brand Design": "brand",
  "Recruitment Platform": "architecture",
};
---

<section id="projects" class="projects-section">
  <div class="max-w-7xl mx-auto px-6 py-24 md:py-32">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">Verified work. Real metrics.</h2>
      <p class="text-muted-foreground text-lg">Every project traces to a verified source. No invented numbers.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {PROJECTS.map((project) => (
        <a key={project.name} href={`/work/${project.name.toLowerCase().replace(/\s+/g, "-")}`} class="block glass card-hover rounded-2xl overflow-hidden transition-all hover:border-blue-500/30">
          <div class="relative aspect-[4/3]">
            <img src={`/imports/projects/${project.image}.webp`} alt={project.imageAlt || project.name} class="w-full h-full object-cover" loading="lazy" />
            <span class="absolute top-4 right-4 text-xs font-medium bg-black/60 backdrop-blur px-2 py-1 rounded-full text-white">GitHub repo</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold mb-2">{project.name}</h3>
            <p class="text-sm text-blue-600 font-medium mb-2">{project.subtitle}</p>
            <p class="text-sm text-muted-foreground mb-4">{project.description}</p>
            <div class="flex flex-wrap gap-2 mb-4">
              {project.tags?.slice(0, 3).map((tag) => (
                <span class="tag text-xs">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-16 text-center">
      <p class="text-muted-foreground mb-6">Ready to build your next AI experience?</p>
      <a href="#contact" class="btn-primary px-8 py-4 rounded-full text-base font-medium transition-all hover:shadow-lg hover:shadow-blue-500/25">
        Discuss your project →
      </a>
    </div>
  </div>
</section>
